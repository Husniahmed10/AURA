# ============================================
# AURA - Environment Variables
# Copy this to .env and fill in your values
# ============================================

# LLM Providers
GROQ_API_KEY=gsk_...
OPENAI_API_KEY=sk-...

# Portkey LLM Gateway
PORTKEY_API_KEY=

# Vector Database
PINECONE_API_KEY=
PINECONE_INDEX_NAME=aura-attacks

# Observability
LANGSMITH_API_KEY=ls-...
LANGSMITH_PROJECT=aura
LOGFIRE_TOKEN=

# Infrastructure (install Redis locally or use Redis Cloud free tier)
REDIS_URL=redis://localhost:6379
